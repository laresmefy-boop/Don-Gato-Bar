                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Filtrar Menú por Categoría
        function filterCategory(category) {
            activeCategory = category;
            
            // Actualizar estado activo de los botones
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.getAttribute('data-category') === category) {
                    btn.classList.add('active', 'border-brand-orange', 'bg-brand-orange', 'text-stone-950', 'shadow-md');
                    btn.classList.remove('border-stone-800', 'bg-stone-900', 'text-stone-300');
                } else {
                    btn.classList.remove('active', 'border-brand-orange', 'bg-brand-orange', 'text-stone-950', 'shadow-md');
                    btn.classList.add('border-stone-800', 'bg-stone-900', 'text-stone-300');
                }
            });

            renderMenu(category);
        }

        // Selección desde las fotos de especialidades
        function selectCategoryFromGallery(category) {
            filterCategory(category);
            const menuSection = document.getElementById('menu');
            menuSection.scrollIntoView({ behavior: 'smooth' });
        }

        // Mostrar Notificación Chapina (Toast)
        function showToast(title, msg) {
            const toast = document.getElementById('toast-notification');
            document.getElementById('toast-title').textContent = title;
            document.getElementById('toast-msg').textContent = msg;

            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 2500);
        }

        // Agregar Item al Carrito sin desplegar drawer obligatoriamente
        function addToCart(id) {
            const item = menuItems.find(p => p.id === id);
            if (!item) return;

            const existingIndex = cart.findIndex(c => c.id === id);

            if (existingIndex > -1) {
                cart[existingIndex].qty += 1;
            } else {
                cart.push({ ...item, qty: 1 });
            }

            updateCartUI();

            // Animación corta en el badge del carrito
            const badge = document.getElementById('cart-badge');
            badge.classList.remove('badge-bounce');
            void badge.offsetWidth; // trigger reflow
            badge.classList.add('badge-bounce');

            showToast("¡Nítido! Agregado", `Se sumó "${item.name}" a tu plato.`);
        }

        // Modificar Cantidad en Carrito
        function updateQty(id, delta) {
            const index = cart.findIndex(c => c.id === id);
            if (index > -1) {
                cart[index].qty += delta;
                if (cart[index].qty <= 0) {
                    cart.splice(index, 1);
                }
            }
            updateCartUI();
        }

        // Actualizar Interfaz del Carrito
        function updateCartUI() {
            const cartItemsContainer = document.getElementById('cart-items');
            const cartTotal = document.getElementById('cart-total');
            const cartBadge = document.getElementById('cart-badge');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            // Actualizar Badge
            cartBadge.textContent = totalQty;
            if (totalQty > 0) {
                cartBadge.classList.remove('scale-0');
                cartBadge.classList.add('scale-100');
            } else {
                cartBadge.classList.remove('scale-100');
                cartBadge.classList.add('scale-0');
            }

            // Actualizar Lista en Drawer
            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div class="text-center py-16 text-stone-500 space-y-3">
                        <i class="fa-solid fa-basket-shopping text-4xl text-stone-700"></i>
                        <p class="text-xs font-semibold">Tu plato está vacío por el momento.<br>¡Agrega unas hamburguesas o frías!</p>
                    </div>
                `;
            } else {
                cartItemsContainer.innerHTML = cart.map(item => `
                    <div class="bg-stone-900 border border-stone-800 p-3.5 rounded-xl flex items-center justify-between gap-3">
                        <div class="flex-1 min-w-0">
                            <h5 class="text-white text-xs font-bold font-display truncate">${item.name}</h5>
                            <span class="text-brand-orange text-xs font-black">Q ${(item.price * item.qty).toFixed(2)}</span>
                        </div>
                        <div class="flex items-center gap-2 bg-stone-800 border border-stone-700 rounded-lg p-1">
                            <button onclick="updateQty(${item.id}, -1)" class="w-6 h-6 rounded bg-stone-700 hover:bg-stone-600 text-white text-xs font-bold flex items-center justify-center transition-colors">-</button>
                            <span class="text-xs font-bold text-white px-1">${item.qty}</span>
                            <button onclick="updateQty(${item.id}, 1)" class="w-6 h-6 rounded bg-brand-orange text-stone-950 font-bold text-xs flex items-center justify-center transition-colors">+</button>
                        </div>
                    </div>
                `).join('');
            }

            cartTotal.textContent = `Q ${totalPrice.toFixed(2)}`;
        }

        // Toggle Abrir/Cerrar Carrito Modal
        function toggleCartModal() {
            const modal = document.getElementById('cart-modal');
            const drawer = document.getElementById('cart-drawer');

            if (modal.classList.contains('invisible')) {
                modal.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
                drawer.classList.remove('translate-x-full');
            } else {
                modal.classList.add('invisible', 'opacity-0', 'pointer-events-none');
                drawer.classList.add('translate-x-full');
            }
        }

        // Enviar Pedido Estructurado por WhatsApp
        function sendOrderWhatsApp() {
            if (cart.length === 0) {
                alert("¡Pilas! Tu lista de pedido está vacía. Agrega algo del menú primero.");
                return;
            }

            const name = document.getElementById('cust-name').value.trim() || 'Cliente Don Gato';
            const type = document.getElementById('cust-type').value;
            const details = document.getElementById('cust-details').value.trim() || 'Sin especificar';
            const notes = document.getElementById('cust-notes').value.trim();

            let message = `🐱 *NUEVO PEDIDO - DON GATO BAR & RESTAURANTE*\n`;
            message += `-----------------------------------\n`;
            message += `👤 *Nombre:* ${name}\n`;
            message += `📌 *Modalidad:* ${type}\n`;
            message += `📍 *Mesa / Hora:* ${details}\n`;
            message += `-----------------------------------\n`;
            message += `🍔 *DETALLE DEL PEDIDO:*\n`;

            cart.forEach(item => {
                message += `• ${item.qty}x ${item.name} (Q ${(item.price * item.qty).toFixed(2)})\n`;
            });

            const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            message += `-----------------------------------\n`;
            message += `💰 *TOTAL A PAGAR:* Q ${total.toFixed(2)}\n`;

            if (notes) {
                message += `📝 *Notas Especiales:* ${notes}\n`;
            }

            message += `-----------------------------------\n`;
            message += `¡Muchas gracias!`;

            const encodedMessage = encodeURIComponent(message);
            // Reemplaza con el número de teléfono real si lo deseas (Ej: 50250000000)
            const whatsappUrl = `https://wa.me/50250000000?text=${encodedMessage}`;

            window.open(whatsappUrl, '_blank');
        }

        // Inicialización al cargar la página
        window.onload = function() {
            renderMenu('hamburguesas');
            updateCartUI();
        };
