<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Don Gato Bar & Restaurante | Poptún, Petén</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            orange: '#F97316',
                            amber: '#F59E0B',
                            dark: '#0B0908',
                            card: '#181513',
                            border: '#2C2724',
                            neon: '#FF5722'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['"Outfit"', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        .glass-header {
            background: rgba(11, 9, 8, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
        .hero-bg {
            background: linear-gradient(180deg, rgba(11, 9, 8, 0.70) 0%, rgba(11, 9, 8, 0.98) 100%), 
                        url('https://images.unsplash.com/photo-1514933651103-005eec06c04b?q=80&w=1920&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #181513;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #F97316;
            border-radius: 4px;
        }
        .insta-gradient {
            background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
        }
        .neon-glow {
            box-shadow: 0 0 25px rgba(249, 115, 22, 0.35);
        }
        @keyframes bounceShort {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.35); }
        }
        .badge-bounce {
            animation: bounceShort 0.3s ease-in-out;
        }
    </style>
</head>
<body class="bg-brand-dark text-stone-200 font-sans antialiased selection:bg-brand-orange selection:text-white flex flex-col min-h-screen">

    <!-- TOAST NOTIFICATION  -->
    <div id="toast-notification" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-3 bg-gradient-to-r from-stone-900 via-stone-900 to-brand-card border-2 border-brand-orange text-white px-5 py-3.5 rounded-2xl shadow-2xl">
        <div class="w-10 h-10 rounded-xl bg-brand-orange/20 text-brand-orange flex items-center justify-center shrink-0 text-xl font-bold">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <div>
            <h5 class="font-black text-sm text-brand-orange font-display" id="toast-title">¡Chilero! Agregado a tu plato</h5>
            <p class="text-xs text-stone-300" id="toast-msg">Se sumó a tu lista. Revisa cuando querás.</p>
        </div>
    </div>

    <!-- HEADER NAVBAR -->
    <header class="fixed top-0 left-0 right-0 z-40 glass-header border-b border-brand-border transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            
            <!-- Logo Oficial de Don Gato -->
            <a href="#" class="flex items-center gap-3 group">
                <img src="https://scontent.fgua10-1.fna.fbcdn.net/v/t39.30808-1/469404618_1066989722104763_5186301571493223136_n.jpg?stp=dst-jpg_tt6&cstp=mx960x960&ctp=s200x200&_nc_cat=102&ccb=1-7&_nc_sid=2d3e12&_nc_ohc=Lvw_DHLrXTUQ7kNvwHVTRyS&_nc_oc=AdogVQOP4Hphm3efFuXipflLTiKyAcKW0zO5zCRPnuwZvttxe1WQNlYOawTL11-69Uo&_nc_zt=24&_nc_ht=scontent.fgua10-1.fna&_nc_gid=Gw8Z9I_aj212PR3VimmVQw&_nc_ss=7b289&oh=00_AQIlDKFU03cszShww_pqRNjI0ZD5HEF5yJkdHO83SwZ1vw&oe=6ABDD945" alt="Don Gato Logo" class="w-12 h-12 rounded-xl object-cover border border-brand-orange/40 shadow-lg shadow-brand-orange/20 transform group-hover:scale-105 transition-transform" onerror="this.onerror=null; this.src='https://placehold.co/100x100/181513/F97316?text=DG';">
                <div>
                    <span class="text-2xl font-black tracking-wider text-white block leading-none font-display">DON GATO</span>
                    <span class="text-[10px] sm:text-xs text-brand-amber font-bold uppercase tracking-widest flex items-center gap-1 mt-0.5">
                        <i class="fa-solid fa-beer-mug-empty text-[10px]"></i> BAR & RESTAURANTE · POPTÚN
                    </span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center gap-8 font-semibold text-sm">
                <a href="#inicio" class="hover:text-brand-orange transition-colors">Inicio</a>
                <a href="#ambiente" class="hover:text-brand-orange transition-colors">Especialidades</a>
                <a href="#menu" class="hover:text-brand-orange transition-colors">Menú </a>
                <a href="https://www.instagram.com/dongato_bar" target="_blank" class="hover:text-brand-orange transition-colors flex items-center gap-1.5">
                    <i class="fa-brands fa-instagram text-pink-500"></i> @dongato_bar
                </a>
                <a href="#contacto" class="hover:text-brand-orange transition-colors">Ubicación</a>
            </nav>

            <!-- Actions -->
            <div class="flex items-center gap-3">
                <a href="https://www.instagram.com/dongato_bar" target="_blank" class="insta-gradient hover:brightness-110 text-white font-bold p-2.5 sm:px-4 sm:py-2 rounded-full text-xs sm:text-sm flex items-center gap-2 shadow-md transition-all">
                    <i class="fa-brands fa-instagram text-base"></i>
                    <span class="hidden sm:inline">Instagram</span>
                </a>

                <!-- Cart Button -->
                <button onclick="toggleCartModal()" class="relative bg-stone-800 hover:bg-stone-700 text-white p-3 rounded-full border border-stone-700 transition-all flex items-center justify-center shadow-md active:scale-95 group" title="Ver mi pedido">
                    <i class="fa-solid fa-utensils text-lg text-brand-orange group-hover:rotate-12 transition-transform"></i>
                    <span id="cart-badge" class="absolute -top-1 -right-1 bg-brand-orange text-stone-950 text-xs font-black w-5 h-5 rounded-full flex items-center justify-center scale-0 transition-transform">0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section id="inicio" class="hero-bg pt-28 pb-16 md:pt-36 md:pb-24 px-4 flex items-center min-h-[85vh] relative overflow-hidden">
        <div class="max-w-4xl mx-auto text-center space-y-6 relative z-10">
            
            <!-- Logo destacado en Hero -->
            <div class="w-28 h-28 sm:w-36 sm:h-36 mx-auto rounded-3xl p-1 bg-gradient-to-tr from-brand-orange via-brand-amber to-yellow-500 shadow-2xl neon-glow">
                <img src="https://iili.io/nRpsiWg.jpg" alt="Logo Don Gato" class="w-full h-full object-cover rounded-[22px] bg-stone-950" onerror="this.onerror=null; this.src='https://placehold.co/200x200/181513/F97316?text=Don+Gato';">
            </div>

            <!-- Notice / Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-stone-900/90 border border-brand-orange/50 text-brand-orange text-xs sm:text-sm font-bold tracking-wide uppercase backdrop-blur-md">
                <i class="fa-solid fa-fire text-brand-amber"></i>  Sabor y buen ambiente en el mismo lugar
            </div>
            
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-white leading-tight font-display tracking-tight">
                Drinks, Food <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-orange via-brand-amber to-yellow-400">& Rock and Roll</span>
            </h1>
            
            <p class="text-stone-300 text-sm sm:text-base max-w-2xl mx-auto font-normal leading-relaxed">
                El mejor ambiente de Poptún para convivir con tus cuates. Disfruta nuestras hamburguesas artesanales, alitas bien crujientes y variedad de chelas
            </p>

            <!-- Botones de Acción -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
                <a href="#menu" class="w-full sm:w-auto bg-gradient-to-r from-brand-orange to-brand-amber text-stone-950 font-black px-8 py-4 rounded-full text-base sm:text-lg shadow-xl neon-glow hover:scale-105 transition-all text-center">
                    <i class="fa-solid fa-burger mr-2"></i> Ver Menú 
                </a>
                <button onclick="toggleCartModal()" class="w-full sm:w-auto bg-stone-900/90 hover:bg-stone-800 border border-green-500/40 text-white font-bold px-8 py-4 rounded-full text-base sm:text-lg backdrop-blur-md transition-all text-center flex items-center justify-center gap-2">
                    <i class="fa-brands fa-whatsapp text-green-500 text-xl"></i> Armar Mi Pedido
                </button>
            </div>
        </div>
    </section>

    <!-- AMBIENTE & ESPECIALIDADES INTERACTIVAS -->
    <section id="ambiente" class="py-16 bg-stone-950 border-y border-stone-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto space-y-3 mb-12">
                <h2 class="text-brand-orange font-bold text-xs tracking-widest uppercase">Especialidades Don Gato</h2>
                <h3 class="text-3xl sm:text-5xl font-black text-white font-display">Toca una foto para ir al Menú</h3>
                <p class="text-stone-400 text-xs sm:text-sm">Selecciona lo que se te antoje y te llevaremos directo a su categoría sin clavos.</p>
            </div>

            <!-- Grid de Fotos Estratégicas Interactivas -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Foto 1: Hamburguesas -->
                <div onclick="selectCategoryFromGallery('hamburguesas')" class="group relative rounded-2xl overflow-hidden border border-stone-800 bg-stone-900 shadow-xl h-72 cursor-pointer transform hover:-translate-y-1 transition-all duration-300">
                    <img src="https://iili.io/nRpbzfn.jpg" alt="Hamburguesas Don Gato" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1568901346375-23c9450c58cd?q=80&w=800&auto=format&fit=crop';">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-6">
                        <span class="inline-block px-3 py-1 bg-brand-orange text-stone-950 font-black text-[10px] uppercase rounded-full w-fit mb-2">¡Haz Clic Aquí!</span>
                        <h4 class="text-white font-black text-xl font-display group-hover:text-brand-orange transition-colors">Hamburguesas Artesanales <i class="fa-solid fa-arrow-right text-xs ml-1"></i></h4>
                        <p class="text-stone-300 text-xs mt-1">Con pan artesanal, carne jugosa y papas fritas incluidas.</p>
                    </div>
                </div>

                <!-- Foto 2: Bebidas y Tragos -->
                <div onclick="selectCategoryFromGallery('bebidas')" class="group relative rounded-2xl overflow-hidden border border-stone-800 bg-stone-900 shadow-xl h-72 cursor-pointer transform hover:-translate-y-1 transition-all duration-300">
                    <img src="https://iili.io/nRpmvQS.jpg" alt="Ambiente Don Gato" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1514933651103-005eec06c04b?q=80&w=800&auto=format&fit=crop';">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-6">
                        <span class="inline-block px-3 py-1 bg-cyan-500 text-stone-950 font-black text-[10px] uppercase rounded-full w-fit mb-2">¡Haz Clic Aquí!</span>
                        <h4 class="text-white font-black text-xl font-display group-hover:text-cyan-400 transition-colors">Cócteles & Tragos <i class="fa-solid fa-arrow-right text-xs ml-1"></i></h4>
                        <p class="text-stone-300 text-xs mt-1">Micheladas, Piconas, Mojitos, Margaritas y más</p>
                    </div>
                </div>

                <!-- Foto 3: Alitas y Boquitas -->
                <div onclick="selectCategoryFromGallery('alitas')" class="group relative rounded-2xl overflow-hidden border border-stone-800 bg-stone-900 shadow-xl h-72 cursor-pointer transform hover:-translate-y-1 transition-all duration-300">
                    <img src="https://iili.io/nRyuBaa.jpg" alt="Alitas Don Gato" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1527477396000-e27163b481c2?q=80&w=800&auto=format&fit=crop';">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-6">
                        <span class="inline-block px-3 py-1 bg-brand-amber text-stone-950 font-black text-[10px] uppercase rounded-full w-fit mb-2">¡Haz Clic Aquí!</span>
                        <h4 class="text-white font-black text-xl font-display group-hover:text-brand-amber transition-colors">Para Compartir <i class="fa-solid fa-arrow-right text-xs ml-1"></i></h4>
                        <p class="text-stone-300 text-xs mt-1">Alitas, Nachos y Papas </p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-6">
                <div onclick="selectCategoryFromGallery('compartir')" class="group relative rounded-2xl overflow-hidden border border-stone-800 bg-gradient-to-br from-stone-800 to-stone-900 shadow-xl h-56 cursor-pointer transform hover:-translate-y-1 transition-all duration-300">
                    <i class="fa-solid fa-blender absolute inset-0 flex items-center justify-center text-6xl text-stone-700"></i>
                    <img src="https://spoonandsip.com/wp-content/uploads/2025/02/smoothie_de_kiwi_y_piC3B1a.jpg" alt="Smoothies" class="relative w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.style.display='none'">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-4">
                        <h4 class="text-white font-black text-base sm:text-lg font-display group-hover:text-brand-orange transition-colors">Smoothies <i class="fa-solid fa-arrow-right text-xs ml-1"></i></h4>
                        <p class="text-stone-300 text-[11px] mt-0.5">Frutas naturales y bien frías</p>
                    </div>
                </div>
                <div onclick="selectCategoryFromGallery('fuertes')" class="group relative rounded-2xl overflow-hidden border border-stone-800 bg-gradient-to-br from-stone-800 to-stone-900 shadow-xl h-56 cursor-pointer transform hover:-translate-y-1 transition-all duration-300">
                    <i class="fa-solid fa-utensils absolute inset-0 flex items-center justify-center text-6xl text-stone-700"></i>
                    <img src="https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=800&auto=format&fit=crop" alt="Platos Fuertes" class="relative w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.style.display='none'">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-4">
                        <h4 class="text-white font-black text-base sm:text-lg font-display group-hover:text-red-400 transition-colors">Platos Fuertes <i class="fa-solid fa-arrow-right text-xs ml-1"></i></h4>
                        <p class="text-stone-300 text-[11px] mt-0.5">Churrasco, pechuga y puyaso</p>
                    </div>
                </div>
                <div onclick="selectCategoryFromGallery('cervezas')" class="group relative rounded-2xl overflow-hidden border border-stone-800 bg-gradient-to-br from-stone-800 to-stone-900 shadow-xl h-56 cursor-pointer transform hover:-translate-y-1 transition-all duration-300">
                    <i class="fa-solid fa-beer-mug-empty absolute inset-0 flex items-center justify-center text-6xl text-stone-700"></i>
                    <img src="https://images.unsplash.com/photo-1535958636474-b021ee887b13?q=80&w=800&auto=format&fit=crop" alt="Cervezas" class="relative w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.style.display='none'">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-4">
                        <h4 class="text-white font-black text-base sm:text-lg font-display group-hover:text-amber-400 transition-colors">Cervezas <i class="fa-solid fa-arrow-right text-xs ml-1"></i></h4>
                        <p class="text-stone-300 text-[11px] mt-0.5">Gallo y Cabro bien heladas</p>
                    </div>
                </div>
                <div onclick="selectCategoryFromGallery('naturales')" class="group relative rounded-2xl overflow-hidden border border-stone-800 bg-gradient-to-br from-stone-800 to-stone-900 shadow-xl h-56 cursor-pointer transform hover:-translate-y-1 transition-all duration-300">
                    <i class="fa-solid fa-lemon absolute inset-0 flex items-center justify-center text-6xl text-stone-700"></i>
                    <img src="https://images.unsplash.com/photo-1600271886742-f049cd451bba?q=80&w=800&auto=format&fit=crop" alt="Naturales & Picheles" class="relative w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.style.display='none'">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent flex flex-col justify-end p-4">
                        <h4 class="text-white font-black text-base sm:text-lg font-display group-hover:text-lime-400 transition-colors">Jugos Naturales <i class="fa-solid fa-arrow-right text-xs ml-1"></i></h4>
                        <p class="text-stone-300 text-[11px] mt-0.5">Naranjadas, limonadas, jamaica y más</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- MENU SECTION -->
    <section id="menu" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="text-center max-w-3xl mx-auto space-y-3 mb-10">
            <h2 class="text-brand-orange font-bold text-xs tracking-widest uppercase"></h2>
            <h3 class="text-3xl sm:text-5xl font-black text-white font-display">Menú</h3>
            <p class="text-stone-400 text-xs sm:text-sm">Explora por categorías. Toca <b>"Agregar"</b> para sumar a tu plato </p>
        </div>

        <!-- Combo Destacado dentro del Menú -->
        <div class="mb-10 bg-gradient-to-r from-stone-900 via-stone-900 to-brand-orange/20 border border-brand-orange/30 rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-2xl relative overflow-hidden">
            <div class="space-y-2 text-center md:text-left z-10">
                <span class="inline-block bg-brand-orange text-stone-950 font-black text-[10px] uppercase px-3 py-1 rounded-full">⭐ La Mera Calidad</span>
                <h4 class="text-2xl sm:text-3xl font-black text-white font-display">Don Gato Burger + Papas Fritas</h4>
                <p class="text-stone-300 text-xs sm:text-sm max-w-xl">Carne jugosa, pan artesanal, vegetales frescos y nuestra cremita de jalapeño semipicante. ¡La consentida de Poptún!</p>
            </div>
            <button onclick="addToCart(26)" class="bg-brand-orange hover:bg-brand-amber text-stone-950 font-black px-6 py-3.5 rounded-2xl shadow-lg transition-transform hover:scale-105 shrink-0 text-sm active:scale-95 z-10 flex items-center gap-2">
                <i class="fa-solid fa-plus font-bold"></i> Agregar Combo (Q 40.00)
            </button>
        </div>

        <!-- Categorías de Filtrado (SIN LA OPCIÓN "TODOS") -->
        <div class="flex items-center justify-start md:justify-center gap-2.5 overflow-x-auto pb-4 custom-scrollbar mb-10">
            <button onclick="filterCategory('hamburguesas')" class="cat-btn active px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap transition-all border border-brand-orange bg-brand-orange text-stone-950 shadow-md flex items-center gap-2" data-category="hamburguesas">
                <i class="fa-solid fa-burger"></i> Hamburguesas
            </button>
            <button onclick="filterCategory('fuertes')" class="cat-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap transition-all border border-stone-800 bg-stone-900 text-stone-300 hover:border-brand-orange flex items-center gap-2" data-category="fuertes">
                <i class="fa-solid fa-utensils"></i> Platos Fuertes
            </button>
            <button onclick="filterCategory('pastas')" class="cat-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap transition-all border border-stone-800 bg-stone-900 text-stone-300 hover:border-brand-orange flex items-center gap-2" data-category="pastas">
                <i class="fa-solid fa-bowl-food"></i> Pastas & Sopas
            </button>
            <button onclick="filterCategory('compartir')" class="cat-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap transition-all border border-stone-800 bg-stone-900 text-stone-300 hover:border-brand-orange flex items-center gap-2" data-category="compartir">
                <i class="fa-solid fa-cheese"></i> Para Compartir
            </button>
            <button onclick="filterCategory('alitas')" class="cat-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap transition-all border border-stone-800 bg-stone-900 text-stone-300 hover:border-brand-orange flex items-center gap-2" data-category="alitas">
                <i class="fa-solid fa-drumstick-bite"></i> Alitas
            </button>
            <button onclick="filterCategory('smoothies')" class="cat-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap transition-all border border-stone-800 bg-stone-900 text-stone-300 hover:border-brand-orange flex items-center gap-2" data-category="smoothies">
                <i class="fa-solid fa-blender"></i> Smoothies & Frappés
            </button>
            <button onclick="filterCategory('naturales')" class="cat-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap transition-all border border-stone-800 bg-stone-900 text-stone-300 hover:border-brand-orange flex items-center gap-2" data-category="naturales">
                <i class="fa-solid fa-lemon"></i> Naturales & Picheles
            </button>
            <button onclick="filterCategory('calientes')" class="cat-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap transition-all border border-stone-800 bg-stone-900 text-stone-300 hover:border-brand-orange flex items-center gap-2" data-category="calientes">
                <i class="fa-solid fa-mug-hot"></i> Bebidas Calientes
            </button>
            <button onclick="filterCategory('cocktails')" class="cat-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap transition-all border border-stone-800 bg-stone-900 text-stone-300 hover:border-brand-orange flex items-center gap-2" data-category="cocktails">
