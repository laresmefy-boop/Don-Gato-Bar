            menuGrid.innerHTML = items.map(item => `
                <div class="bg-stone-900 border border-stone-800 rounded-2xl p-5 flex flex-col justify-between hover:border-brand-orange/40 transition-all shadow-md group">
                    <div class="space-y-2">
